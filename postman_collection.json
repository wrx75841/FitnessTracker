{
  "info": {
    "name": "FitnessTracker User API",
    "description": "Collection of API requests for User CRUD operations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/users",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users"]
        }
      }
    },
    {
      "name": "Get Simple Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/users/simple",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "simple"]
        }
      }
    },
    {
      "name": "Get User by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "{{userId}}"]
        }
      }
    },
    {
      "name": "Search Users by Email Fragment",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/users/email?email={{emailFragment}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "email"],
          "query": [
            {
              "key": "email",
              "value": "{{emailFragment}}"
            }
          ]
        }
      }
    },
    {
      "name": "Get Users Older Than Date",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/users/older/{{date}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "older", "{{date}}"]
        }
      }
    },
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"birthdate\": \"1990-01-01\",\n  \"email\": \"john.doe@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/users",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users"]
        }
      }
    },
    {
      "name": "Update User",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"birthdate\": \"1990-01-01\",\n  \"email\": \"jane.doe@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "{{userId}}"]
        }
      }
    },
    {
      "name": "Delete User",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "{{userId}}"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "emailFragment",
      "value": "example"
    },
    {
      "key": "date",
      "value": "2000-01-01"
    }
  ]
}